{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@marinara-engine/shared": ["src/shared/index.ts"],
      "clsx": ["src/compat/clsx.ts"],
      "tailwind-merge": ["src/compat/tailwind-merge.ts"],
      "i18next": ["src/compat/i18next.ts"],
      "react-i18next": ["src/compat/react-i18next.ts"],
      "sonner": ["src/compat/sonner.ts"]
    }
  },
  "include": ["src"]
}
